648 \u0627\u06cc\u0633\u0627 \u06c1\u0648\u062c\u0627\u062a\u0627\u06d4 \u0628\u0644\u06a9\u06c1 \u06cc\u06c1 \u06a9\u06c1\u0648 \u06a9\u06c1 \u06cc\u06c1 \u0627\u0644\u0644\u06c1 \u06a9\u06cc \u062a\u0642\u062f\u06cc\u0631 \u06c1\u06d2 \u0627\u0648\u0631 \u0648\u06c1 \u062c\u0648 \u0686\u0627\u06c1\u062a\u0627 \u06c1\u06d2 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u06a9\u06cc\u0648\u06ba \u06a9\u06c1 \u201d\u0627\u06af\u0631\u201c \u0634\u06cc\u0637\u0627\u0646 \u06a9\u06d2 \u0639\u0645\u0644 \u062f\u062e\u0644 \u06a9\u0627 \u062f\u0631\u0648\u0627\u0632\u06c1 \u06a9\u06be\u0648\u0644 \u062f\u06cc\u062a\u0627 \u06c1\u06d2\u201c\u06d4","attribution":"\u0631\u0648\u0627\u0647 \u0645\u0633\u0644\u0645","grade":"\u0635\u062d\u064a\u062d","explanation":"\u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u0646\u0628\u06cc \u0635\u0644\u06cc \u0627\u0644\u0644\u06c1 \u0639\u0644\u06cc\u06c1 \u0648 \u0633\u0644\u0645 \u0628\u062a\u0627 \u0631\u06c1\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0648\u06cc\u0633\u06d2 \u062a\u0648 \u06c1\u0631 \u0645\u0648\u0645\u0646 \u0645\u06cc\u06ba \u062e\u06cc\u0631 \u06c1\u0648\u062a\u06cc \u06c1\u06d2\u060c \u0644\u06cc\u06a9\u0646 \u0627\u06cc\u0645\u0627\u0646\u060c \u0639\u0632\u06cc\u0645\u062a \u0627\u0648\u0631 \u0645\u0627\u0644 \u0648\u063a\u06cc\u0631\u06c1 \u0637\u0627\u0642\u062a \u06a9\u06d2 \u067e\u06c1\u0644\u0648\u0624\u06ba \u0645\u06cc\u06ba \u0642\u0648\u06cc \u0645\u0648\u0645\u0646 \u0627\u0644\u0644\u06c1 \u0639\u0632 \u0648 \u062c\u0644 \u06a9\u06d2 \u06cc\u06c1\u0627\u06ba \u06a9\u0645\u0632\u0648\u0631 \u0645\u0648\u0645\u0646 \u0633\u06d2 \u0628\u06c1\u062a\u0631 \u0627\u0648\u0631 \u0632\u06cc\u0627\u062f\u06c1 \u0645\u062d\u0628\u0648\u0628 \u06c1\u06d2\u06d4 \u0627\u0633 \u06a9\u06d2 \u0628\u0639\u062f \u0627\u0644\u0644\u06c1 \u06a9\u06d2 \u0646\u0628\u06cc \u0635\u0644\u06cc \u0627\u0644\u0644\u06c1 \u0639\u0644\u06cc\u06c1 \u0648 \u0633\u0644\u0645 \u0646\u06d2 \u0645\u0648\u0645\u0646 \u06a9\u0648 \u0627\u06cc\u0633\