4\u0647 \u0648\u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u064a\u0647\u060c \u0648\u0641\u0639\u0644 \u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\u0629.","\u0648\u062c\u0648\u0628 \u0627\u0644\u0625\u064a\u0645\u0627\u0646 \u0628\u0642\u0636\u0627\u0621 \u0627\u0644\u0644\u0647 \u0648\u0642\u062f\u0631\u0647\u060c \u0648\u0623\u0646 \u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0628\u064a\u062f \u0627\u0644\u0644\u0647 \u0648\u0647\u0648 \u0627\u0644\u0630\u064a \u064a\u062c\u0631\u064a\u0647\u0627 \u0623\u0648 \u064a\u0633\u0644\u0628 \u062a\u0623\u062b\u064a\u0631\u0647\u0627.","\u0625\u0628\u0637\u0627\u0644 \u0645\u0627 \u064a\u0641\u0639\u0644\u0647 \u0628\u0639\u0636 \u0627\u0644\u0646\u0627\u0633 \u0645\u0646 \u0627\u0644\u062a\u0634\u0627\u0624\u0645 \u0628\u0627\u0644\u0623\u0644\u0648\u0627\u0646\u060c \u0643\u0627\u0644\u0623\u0633\u0648\u062f \u0648\u0627\u0644\u0623\u062d\u0645\u0631\u060c \u0623\u0648 \u0628\u0639\u0636 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0648\u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0648\u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0648\u0630\u0648\u064a \u0627\u0644\u0639\u0627\u0647\u0627\u062a.","\u0641\u064a \u0627\u0644\u0646\u0647\u064a \u0639\u0646 \u0627\u0644\u0642\u0631\u0628 \u0645\u0646 \u0627\u0644\u0645\u062c\u0630\u0648\u0645 \u0648\u0645\u062b\u0644\u0647 \u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0645\u0639\u062f\u064a\u0629\u061b \u0647\u0648 \u0645\u0646 \u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u062a\u064a \u0623\u062c\u0631\u0649 \u0627\u0644\u0644\u0647 \u0627\u0644\u0639\u0627\u062f\u0629 \u0628\u0623\u0646\u0647\u0627 \u062a\u0641\u0636\u064a \u0625\u0644\u0649 \u0645\u0633\u0628\u0628\u0627\u062a\u0647\u0627\u061b \u0641\u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0644\u0627 \u062a\u0633\u062a\u0642\u0644 \u0628\u0630\u0627\u062a\u0647\u0627\u060c \u0628\u0644 \u0627\u0644\u0644\u0647 \u0647\u0648 \u0627\u0644\u0630\u064a \u0625\u0646 \u0634\u0627\u0621 \u0633\u0644\u0628\u0647\u0627 \u0642\u0648\u0627\u0647\u0627 \u0641\u0644\u0627 \u062a\u0624\u062b\u0631 \u0634\u064a\u0626\u064b\u0627\u060c \u0648\u0625\u0646 \u0634\u0627\u0621 \u0623\u0628\u0642\u0627\u0647\u0627 \u0641\u0623\u062b\u0631\u062a."],"words_meanings_ar":[],"attribution_ar":"\u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647","grade_ar":"\u0635\u062d\u064a\u062d"}